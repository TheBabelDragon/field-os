{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheBabelDragon/field-os/schema/observation.schema.json",
  "title": "Observation",
  "type": "object",
  "required": ["field", "value", "provenance"],
  "properties": {
    "field": { "type": "string", "minLength": 1 },
    "channel": { "type": "string" },
    "location": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "id": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "value": { "type": "number" },
    "unit": { "type": "string" },
    "uncertainty": { "type": "number", "minimum": 0 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "timestamp_ns": { "type": "integer" },
    "field_epoch": { "type": "integer", "minimum": 0 },
    "field_sequence": { "type": "integer", "minimum": 0 },
    "node_id": { "type": "string" },
    "sequence": { "type": "integer", "minimum": 0 },
    "provenance": { "$ref": "provenance.schema.json" }
  }
}
