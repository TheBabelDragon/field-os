{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheBabelDragon/field-os/schema/field_tick.schema.json",
  "title": "FieldTick",
  "description": "field-os v0.1 atomic application of a sorted FieldDelta list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "epoch", "sequence", "deltas", "state_hash"],
  "properties": {
    "contract": { "type": "string", "const": "0.1" },
    "epoch": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 0 },
    "dt": { "type": "number" },
    "state_hash": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16,
      "description": "First 16 hex chars of SHA-256(canonical committed field state). Not a hash of this FieldTick object."
    },
    "audits": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rejected": {
      "type": "array",
      "items": { "type": "string" }
    },
    "deltas": {
      "type": "array",
      "items": { "$ref": "field_delta.schema.json" }
    }
  }
}
